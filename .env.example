BOT_NAME=MANUKA-MD
OWNER_NAME=Manuka Chamath
MENU_IMAGE=./assets/menu.jpg
SETTINGS_FILE=./data/settings.json
PREFIX=.
# self = commands sent by linked account only; public = other users too
MODE=self
AUTH_DIR=./auth
AI_PROVIDER=groq\n# Add your real key ONLY to your local .env, NEVER commit it\nGROQ_API_KEY=\nGROQ_MODEL=openai/gpt-oss-20b\nOLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Personal notes/tasks/expenses store
FEATURES_FILE=./data/features.json

# Direct file downloads: 1–100 MB (default 50)
MAX_FILE_MB=50
# Optional online voice replies (Google TTS receives spoken text)
VOICE_LANG=si
# Windows: python; Linux: python3. Use full path if needed.
PYTHON_PATH=python3
